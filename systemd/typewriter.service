[Unit]
Description=Typewriter Writing Appliance
After=systemd-user-sessions.service
After=getty.target
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/opt/typewriter/venv/bin/python /opt/typewriter/app.py
WorkingDirectory=/opt/typewriter
Environment=TYPEWRITER_DATA_DIR=/home/writer/.local/share/typewriter
Environment=TYPEWRITER_LEGACY_NOTE=/home/writer/.typewriter/note.txt
Environment=HOME=/home/writer
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=on-failure
RestartSec=2
User=writer
Group=writer

[Install]
WantedBy=multi-user.target
